rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function hasDvcrAdminClaim() {
      return isAuth()
        && 'dvcr_admin' in request.auth.token
        && request.auth.token.dvcr_admin == true;
    }

    function userDocPath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function userDocExists() {
      return isAuth() && firestore.exists(userDocPath());
    }

    function userDoc() {
      return firestore.get(userDocPath());
    }

    function userRoles() {
      return userDocExists() ? userDoc().data.get('roles', []) : [];
    }

    function isTeamDvcrMember() {
      return isAuth()
        && userDocExists()
        && (
          'team_dvcr' in userRoles()
          || 'teamDvcr' in userRoles()
        );
    }

    // Aligné Firestore isAdmin() : rôles doc + claim custom.
    function isAdminUser() {
      return isAuth() && (
        hasDvcrAdminClaim()
        || (
          userDocExists()
          && (
            'admin' in userRoles()
            || userDoc().data.get('role', '') == 'admin'
          )
        )
      );
    }

    function isPdfUpload() {
      return request.resource != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // PDF espace bénévoles — lecture : Membre DVCR ; écriture : admin
    match /benevole_docs/{fileId} {
      allow read: if isTeamDvcrMember() || isAdminUser();
      allow create, update: if isAdminUser() && isPdfUpload();
      allow delete: if isAdminUser();
    }

    // Aligné Firestore canWriteMatchOperations()
    function isMatchStaff() {
      return isAuth()
        && (
          isAdminUser()
          || (
            userDocExists()
            && (
              'community_manager' in userRoles()
              || 'statisticien' in userRoles()
            )
          )
        );
    }

    // Web/mobile : contentType souvent vide, octet-stream, ou MIME imprécis.
    // Staff + taille suffisent ; on accepte audio/*, video/*, octet-stream, vide.
    function isLooseMediaType() {
      return request.resource != null
        && (
          request.resource.contentType == null
          || request.resource.contentType.size() == 0
          || request.resource.contentType == 'application/octet-stream'
          || request.resource.contentType == 'binary/octet-stream'
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType.matches('video/.*')
        );
    }

    function isStaffMediaUpload(maxBytes) {
      return isMatchStaff()
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size < maxBytes
        && isLooseMediaType();
    }

    // Clips commentateur liés aux faits de jeu (MVP)
    match /match_commentary/{matchId}/{fileName} {
      allow read: if true;
      allow create, update: if isStaffMediaUpload(5 * 1024 * 1024);
      allow delete: if isMatchStaff();
    }

    // Parole du coach (discours post-match sur la fiche Résumé)
    match /match_coach_audio/{matchId}/{fileName} {
      allow read: if true;
      allow create, update: if isStaffMediaUpload(15 * 1024 * 1024);
      allow delete: if isMatchStaff();
    }

    // Extraits vMix liés aux faits de jeu
    match /match_highlights/{matchId}/{fileName} {
      allow read: if true;
      allow create, update: if isStaffMediaUpload(40 * 1024 * 1024);
      allow delete: if isMatchStaff();
    }

    // Exports résumé (écrits par Cloud Functions / staff)
    // delete : pas de request.resource → isMatchStaff seul
    match /match_highlights/{matchId}/exports/{fileName} {
      allow read: if true;
      allow create, update: if isStaffMediaUpload(40 * 1024 * 1024);
      allow delete: if isMatchStaff();
    }

    // Bibliothèque de stingers (admin / staff match)
    match /match_stingers/{fileName} {
      allow read: if true;
      allow create, update: if isStaffMediaUpload(40 * 1024 * 1024);
      allow delete: if isMatchStaff();
    }

    // Logo partenaire cadre souvenir (asset club — pas de photo fan)
    function isLooseImageType() {
      return request.resource != null
        && (
          request.resource.contentType == null
          || request.resource.contentType.size() == 0
          || request.resource.contentType == 'application/octet-stream'
          || request.resource.contentType == 'binary/octet-stream'
          || request.resource.contentType.matches('image/.*')
        );
    }

    match /match_souvenir/{fileName} {
      allow read: if true;
      allow create, update: if isAdminUser()
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024
        && isLooseImageType();
      allow delete: if isAdminUser();
    }
  }
}
