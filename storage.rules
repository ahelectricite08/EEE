rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isTeamDvcrMember() {
      return isAuth()
        && userDoc().data != null
        && (
          'team_dvcr' in userDoc().data.get('roles', [])
          || 'teamDvcr' in userDoc().data.get('roles', [])
        );
    }

    function isAdminUser() {
      return isAuth()
        && userDoc().data != null
        && (
          'admin' in userDoc().data.get('roles', [])
          || userDoc().data.get('role', '') == 'admin'
        );
    }

    function isPdfUpload() {
      return request.resource != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // PDF espace bénévoles — lecture : Membre DVCR ; écriture : admin
    match /benevole_docs/{fileId} {
      allow read: if isTeamDvcrMember() || isAdminUser();
      allow create, update: if isAdminUser() && isPdfUpload();
      allow delete: if isAdminUser();
    }

    function isMatchStaff() {
      return isAuth()
        && userDoc().data != null
        && (
          isAdminUser()
          || 'community_manager' in userDoc().data.get('roles', [])
          || 'statisticien' in userDoc().data.get('roles', [])
        );
    }

    function isMatchCommentaryAudio() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && (
          request.resource.contentType == 'audio/mp4'
          || request.resource.contentType == 'audio/m4a'
          || request.resource.contentType == 'audio/aac'
          || request.resource.contentType == 'audio/mpeg'
        );
    }

    // Clips commentateur liés aux faits de jeu (MVP)
    match /match_commentary/{matchId}/{fileName} {
      allow read: if true;
      allow create, update: if isMatchStaff() && isMatchCommentaryAudio();
      allow delete: if isMatchStaff();
    }

    function isMatchCoachAudio() {
      return request.resource != null
        && request.resource.size < 15 * 1024 * 1024
        && (
          request.resource.contentType == 'audio/mp4'
          || request.resource.contentType == 'audio/m4a'
          || request.resource.contentType == 'audio/aac'
          || request.resource.contentType == 'audio/mpeg'
        );
    }

    // Parole du coach (discours post-match sur la fiche Résumé)
    match /match_coach_audio/{matchId}/{fileName} {
      allow read: if true;
      allow create, update: if isMatchStaff() && isMatchCoachAudio();
      allow delete: if isMatchStaff();
    }

    function isMatchHighlightVideo() {
      return request.resource != null
        && request.resource.size < 40 * 1024 * 1024
        && (
          request.resource.contentType == 'video/mp4'
          || request.resource.contentType == 'video/quicktime'
        );
    }

    // Extraits vMix liés aux faits de jeu
    match /match_highlights/{matchId}/{fileName} {
      allow read: if true;
      allow create, update: if isMatchStaff() && isMatchHighlightVideo();
      allow delete: if isMatchStaff();
    }

    // Exports résumé (écrits par Cloud Functions / staff)
    match /match_highlights/{matchId}/exports/{fileName} {
      allow read: if true;
      allow create, update, delete: if isMatchStaff() && isMatchHighlightVideo();
    }

    // Bibliothèque de stingers (admin / staff match)
    match /match_stingers/{fileName} {
      allow read: if true;
      allow create, update: if isMatchStaff() && isMatchHighlightVideo();
      allow delete: if isMatchStaff();
    }
  }
}
