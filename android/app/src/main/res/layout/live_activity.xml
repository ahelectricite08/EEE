<?xml version="1.0" encoding="utf-8"?>
<!-- Style MLB : logo | abbrev/score — LIVE/minute — score/abbrev | logo + barre événement -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFF4F0E6"
    android:orientation="vertical">

    <!-- ── Ligne principale ──────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Équipe 1 : logo + abbrev + score -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Cadre blanc logo -->
            <FrameLayout
                android:id="@+id/team1_logo_frame"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/live_logo_card_bg"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/team1_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/team1_monogram"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="—"
                    android:textColor="#FF0A4438"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Abbrev + score -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/team1_abbrev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FF5E6662"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/team1_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="0"
                    android:textColor="#FF0A1C18"
                    android:textSize="34sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Centre : minute seule (rien avant le coup d'envoi) -->
        <TextView
            android:id="@+id/match_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/live_minute_chip"
            android:gravity="center"
            android:minWidth="64dp"
            android:maxWidth="92dp"
            android:includeFontPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:text=""
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="13sp" />

        <!-- Équipe 2 : score + abbrev + logo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical|end"
            android:orientation="horizontal">

            <!-- Score + abbrev (alignés à droite) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/team2_abbrev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="#FF5E6662"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/team2_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:text="0"
                    android:textColor="#FF0A1C18"
                    android:textSize="34sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Cadre blanc logo -->
            <FrameLayout
                android:id="@+id/team2_logo_frame"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/live_logo_card_bg"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/team2_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/team2_monogram"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="—"
                    android:textColor="#FF0A4438"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ── Séparateur ─────────────────────────────────────────────────────── -->
    <View
        android:id="@+id/event_separator"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FFE6E0D1" />

    <!-- ── Barre événement ────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/event_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="visible">

        <!-- Texte événement (contient déjà l'emoji ⚽ 🟨 🟥 etc.) -->
        <TextView
            android:id="@+id/last_event"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF0A1C18"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Champs techniques cachés (utilisés par le plugin) -->
    <ImageView android:id="@+id/team1_image_placeholder" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <ImageView android:id="@+id/team2_image_placeholder" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Chronometer android:id="@+id/match_time" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

</LinearLayout>
